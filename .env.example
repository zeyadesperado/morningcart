# MorningCart environment — copy what you need; nothing here is auto-loaded.
# Backend reads these from the process environment (export them or use compose).

# ── Backend (api/) ────────────────────────────────────────────────────────────
# Postgres connection. Unix-socket form also works:
#   postgresql://you@localhost/morningcart?host=/var/run/postgresql
DATABASE_URL=postgresql://morningcart:morningcart@localhost:5432/morningcart

# Signs the identity cookie. REQUIRED when DEBUG=false (the API refuses to boot
# without it). Generate: openssl rand -hex 32
COOKIE_SECRET=

# 'true' enables the insecure dev fallback secret + Django debug pages. Default: true.
DEBUG=true

# Comma-separated. Default '*' (fine on a trusted LAN; pin it on anything public).
ALLOWED_HOSTS=*

# Timezone the daily service date rolls over in. Default Africa/Cairo.
OFFICE_TZ=Africa/Cairo

# Set true when serving over HTTPS so the cookie is never sent in clear. Default: false.
COOKIE_SECURE=false

# Docker entrypoint only: run `manage.py seed` on boot. The seed is a no-op when
# data already exists (use `manage.py seed --force` to wipe and reseed).
SEED_ON_BOOT=true

# Django admin (/admin). Set both and the entrypoint creates the superuser on
# first boot (create-only: an existing account is never touched, so a password
# changed in the UI survives restarts). Weak passwords fail the boot loudly.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set true (one boot) to force-reset the admin password back to ADMIN_PASSWORD.
ADMIN_FORCE_PASSWORD=false

# Comma-separated origins allowed to POST to the admin when it's served through
# an HTTPS tunnel/proxy, e.g. https://breakfast.example.com
CSRF_TRUSTED_ORIGINS=

# Gunicorn bind port inside the api container. Default: 4000.
PORT=4000

# ── Frontend (web/, dev only) ─────────────────────────────────────────────────
# Where the Vite dev proxy sends /api. Default http://localhost:4000.
VITE_API_TARGET=http://localhost:4000
