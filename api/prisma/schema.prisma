// MorningCart — Postgres schema. Money is integer piasters everywhere.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id          String     @id @default(cuid())
  name        String
  arabic      String?
  deliveryFee Int // piasters; fixed, split across submitters at close
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  menu        MenuItem[]
  sessions    Session[]
}

model MenuItem {
  id           String      @id @default(cuid())
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  arabic       String?
  price        Int // piasters
  kind         String      @default("plate") // 'plate' | 'drink' | 'extra' (display grouping only)
  available    Boolean     @default(true)
  sortOrder    Int         @default(0)
  orderLines   OrderLine[]

  @@index([restaurantId])
}

model Session {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  startedBy    String
  status       String     @default("open") // 'open' | 'closed'
  serviceDate  String // 'YYYY-MM-DD' in office-local time
  createdAt    DateTime   @default(now())
  closedAt     DateTime?
  orders       Order[]

  // Only one OPEN session per restaurant per day is also enforced by a partial
  // unique index added in the migration SQL, and guarded in the start handler.
  @@index([restaurantId, status])
}

model Order {
  id        String      @id @default(cuid())
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  person    String
  paid      Boolean     @default(false) // the entire "payment" surface
  createdAt DateTime    @default(now())
  lines     OrderLine[]

  @@unique([sessionId, person]) // one order per person -> upsert
  @@index([sessionId])
}

model OrderLine {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  qty        Int
  note       String?
  forName    String? // order-on-behalf; never adds a delivery head
  unitPrice  Int // snapshot at add time so later price edits can't change a bill

  @@index([orderId])
}
